# ---------------------------------------------------------------------------
# Autonomous Ad Engine — environment variables
# Real values live ONLY in DigitalOcean App Platform encrypted env vars.
# Never commit real secrets. Every variable the system reads is listed here.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Postgres connection string (DigitalOcean managed Postgres in production;
# App Platform injects it via the ${db.DATABASE_URL} binding — never paste
# production credentials anywhere else). URLs with sslmode=require get TLS.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/adengine
# Optional: the managed database's CA certificate (PEM) to fully verify the
# server in TLS connections; without it TLS is used with verification off.
DATABASE_CA_CERT=
# Port the API listens on (App Platform injects PORT)
PORT=3000
# Node environment: development | test | production
NODE_ENV=development
# Base public URL of the api component (used for hosted pages/forms links)
PUBLIC_BASE_URL=http://localhost:3000

# --- Driver modes (stub = deterministic, no secrets; live = real calls) -----
# Meta adapter mode: stub | live
META_MODE=stub
# Google adapter mode: stub | live
GOOGLE_MODE=stub
# TikTok adapter mode: stub | live
TIKTOK_MODE=stub
# Snapchat adapter mode: stub | live
SNAPCHAT_MODE=stub
# Pinterest adapter mode: stub | live
PINTEREST_MODE=stub
# LLM (classification, narration, copy) mode: stub | live. Leave unset in
# production: Settings → Connected accounts → AI controls it from the UI.
LLM_MODE=stub
# Creative generation provider (image/video) mode: stub | live
CREATIVE_MODE=stub
# Billing / connection health checks mode: stub | live
BILLING_MODE=stub
# Operator email notifications mode: stub | live
EMAIL_MODE=stub

# --- LLM (P3) ----------------------------------------------------------------
# Provider for classification/copy/narration: anthropic | openai | deepseek | llama
LLM_PROVIDER=anthropic
# Anthropic (Claude) — required when LLM_PROVIDER=anthropic and LLM_MODE=live
ANTHROPIC_API_KEY=
# Claude model id (e.g. claude-sonnet-4-6, claude-haiku-4-5, claude-opus-4-8)
ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional override (e.g. Azure-compatible gateway)
OPENAI_BASE_URL=
# DeepSeek — required when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=
# Llama via any OpenAI-compatible host (Groq/Together/Fireworks/vLLM/Ollama)
# Base URL is required when LLM_PROVIDER=llama, e.g. https://api.groq.com/openai/v1
LLAMA_BASE_URL=
# Key optional for unauthenticated local endpoints
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.3-70b
# Cost-ledger price overrides in USD per million tokens (else per-provider defaults)
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=

# --- Creative generation (P4) ------------------------------------------------
# Image/video generation provider API key — required only when CREATIVE_MODE=live
CREATIVE_API_KEY=
# Provider identifier (documented contract; e.g. "openai-images", "runway")
CREATIVE_PROVIDER=stub

# --- Meta (P5) ----------------------------------------------------------------
# Long-lived system-user token with ads_management, ads_read, business_management
META_ACCESS_TOKEN=
# Ad account id (act_…)
META_AD_ACCOUNT_ID=
# Meta pixel/dataset id for CAPI relay
META_DATASET_ID=

# --- Google (P5) ---------------------------------------------------------------
# OAuth2 refresh token for the Google Ads API
GOOGLE_ADS_REFRESH_TOKEN=
# Developer token
GOOGLE_ADS_DEVELOPER_TOKEN=
# Customer id (xxx-xxx-xxxx)
GOOGLE_ADS_CUSTOMER_ID=
# OAuth client id / secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- TikTok (P5) ----------------------------------------------------------------
# Business API access token
TIKTOK_ACCESS_TOKEN=
# Advertiser id
TIKTOK_ADVERTISER_ID=
# Events API pixel code
TIKTOK_PIXEL_CODE=

# --- Snapchat (P5) ---------------------------------------------------------------
# Marketing API access token
SNAPCHAT_ACCESS_TOKEN=
# Ad account id
SNAPCHAT_AD_ACCOUNT_ID=
# Snap pixel id for the Conversions API relay
SNAPCHAT_PIXEL_ID=

# --- Pinterest (P5) ---------------------------------------------------------------
# Pinterest API v5 access token
PINTEREST_ACCESS_TOKEN=
# Ad account id (used for campaigns and the Conversions API relay)
PINTEREST_AD_ACCOUNT_ID=

# --- Notifications (W5) --------------------------------------------------------
# Where operator emails go (attention alerts, approval confirmations, digest)
OPERATOR_EMAIL=
# Resend API key — required only when EMAIL_MODE=live
RESEND_API_KEY=
# From address for outbound email (must be a verified sender in live mode)
EMAIL_FROM=

# --- Ingestion ----------------------------------------------------------------
# Salt used when hashing per-site API keys at rest (any long random string)
SITE_KEY_SALT=change-me-in-production

# --- Workers --------------------------------------------------------------------
# Fast loop cadence in milliseconds (default 5 minutes)
FAST_LOOP_INTERVAL_MS=300000
# Medium loop runs daily via scheduler; cron expression override
MEDIUM_LOOP_CRON=0 6 * * *
# Feed re-sync cadence in hours (4-6h per SW §5.1)
FEED_SYNC_HOURS=4
